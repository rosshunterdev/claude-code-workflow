{
  "permissions": {
    "allow": [
      "Bash(adb *)",
      "Read",
      "Write",
      "Edit",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(.credentials.json)",
      "Read(~/.claude/daemon/**)",
      "Read(~/.claude/history*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(powershell *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(Invoke-RestMethod *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git branch -d*)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "PowerShell(git push*)",
      "PowerShell(gh pr merge*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/block-network.js",
            "timeout": 5,
            "statusMessage": "Checking for network commands..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/git-ask.js",
            "timeout": 5,
            "statusMessage": "Checking git branch..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/notify.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/notify.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "expo@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "impeccable@impeccable": false,
    "block-dangerous-commands@claude-code-hooks": true,
    "protect-secrets@claude-code-hooks": true,
    "git-safety@claude-code-hooks": false
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "claude-code-hooks": {
      "source": {
        "source": "github",
        "repo": "karanb192/claude-code-hooks"
      }
    }
  }
}
